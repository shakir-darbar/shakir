# .gitignore for the Cough‑Based Respiratory Disease Classification project
# ---------------------------------------------------------------
# Ignore virtual‑environment directories (both common names)
.env
.env*
.venv
venv/
ENV/
env/
# Ignore Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
# Ignore Jupyter notebook checkpoints (if any)
.ipynb_checkpoints/
# Ignore IDE specific files
.vscode/
.idea/
# MacOS / Windows system files
.DS_Store
Thumbs.db
# Ignore data that should not be version‑controlled
# Raw audio data – can be huge and may contain personal information
data/raw/
# Processed feature arrays – generated each run
data/processed/
# Model checkpoints and large model files (they are generated by the pipeline)
models/checkpoints/
best_model.h5
# Logs, temporary files, and plots generated during runs
logs/
*.log
plots/*.png
# Secret files – API keys, credentials, etc.
*.secret
secrets.json
# Any other environment files you may add later
*.env
# End of .gitignore

# --- Phase 2 and 3 Massive Files (DO NOT PUSH TO GITHUB) ---
data/augmented_png/
data/spectrograms/
models_augmented/
models/
*.keras
*.npy
